{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentKB",
  "mainBinaryName": "AgentKB",
  "version": "1.32.0",
  "identifier": "io.github.moqi777.agentkb",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "just vite-dev",
    "beforeBuildCommand": "just frontend-build"
  },
  "app": {
    "windows": [
      {
        "titleBarStyle": "Overlay",
        "label": "main",
        "title": "",
        "width": 1200,
        "height": 800,
        "minWidth": 380,
        "minHeight": 400,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": true,
        "focus": true,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; font-src 'self' data:; frame-ancestors 'none'",
      "capabilities": [
        "default"
      ]
    }
  },
  "plugins": {},
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "minimumSystemVersion": "10.13"
    }
  }
}
